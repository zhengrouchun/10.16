    OLED_GLYPH_WIDTH = 5, /* 字形本体占5列。 */
    OLED_CHARACTER_WIDTH = 6, /* 每个字符额外保留1列间隔。 */
    OLED_TIMEOUT_MS = 25, /* 单次I2C传输最长等待25ms，停止中断仍可响应。 */
    OLED_PROBE_TIMEOUT_MS = 3 /* 每次地址探测只等待3ms。 */
};
static uint8_t address_7bit; /* 保存响应的七位地址，不混用0x78格式的总线字节。 */
