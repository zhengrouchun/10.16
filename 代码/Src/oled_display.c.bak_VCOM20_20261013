static void (*progress_callback)(int completed_pages); /* 可选页完成通知；未注册时为空，不影响独立使用。 */
static const char *probe_error[2] = {"NOT_TRIED", "NOT_TRIED"}; /* 分别保留0x3C和0x3D的探测结果。 */
static const char *probe_stage[2] = {"IDLE", "IDLE"}; /* 保留每个候选地址的失败阶段，后一次探测不覆盖前一次。 */
static char lines[OLED_TEXT_ROWS][OLED_TEXT_COLUMNS + 1]; /* 保存八行等宽ASCII文字。 */
