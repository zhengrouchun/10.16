static int SendBytes(uint8_t *data, uint16_t count) /* 统一检查选定总线的传输结果。 */
{
#if OLED_USE_SOFTWARE_I2C /* 仿真兼容版使用普通GPIO产生协议时序。 */
    if (!OledBus_Write(address_7bit, data, count)) /* 只有全部字节得到ACK且STOP成功才算发送成功。 */
#else /* 保留硬件驱动作为明确可选的对照。 */
    if (HAL_I2C_Master_Transmit(&hi2c1, (uint16_t)(address_7bit << 1), data, count, OLED_TIMEOUT_MS) != HAL_OK) /* HAL要求把七位地址左移一位。 */
#endif /* 两条路径共用下面的离线处理。 */
    {
        online = 0; /* 通信失败后标记离线，禁止继续假称刷新成功。 */
        return 0; /* 及时返回主循环，按钮功能仍可运行。 */
    }
    return 1; /* 本次传输完整成功。 */
}
int Oled_IsOnline(void) /* 对外报告实际通信状态。 */
{
    return online; /* 返回最近一次传输结果。 */
}
uint8_t Oled_Address(void) /* 返回七位地址供串口诊断。 */
{
    return online ? address_7bit : 0; /* 离线时不报告一个未确认的有效地址。 */
}
const char *Oled_ProbeError(uint8_t candidate) /* 查询指定七位地址最近一次探测的错误。 */
{
    if (candidate != 0x3C && candidate != 0x3D) /* 本驱动仅支持SSD1306的两个候选地址。 */
    {
        return "INVALID_ADDRESS"; /* 拒绝把无关地址映射到已有结果。 */
    }
    return probe_error[candidate == 0x3D]; /* 0x3C取第一项，0x3D取第二项。 */
}
const char *Oled_ProbeStage(uint8_t candidate) /* 查询指定七位地址的失败位置。 */
{
    if (candidate != 0x3C && candidate != 0x3D) /* 与错误查询使用相同的地址校验。 */
    {
        return "INVALID_ADDRESS"; /* 防止报告与地址不对应的阶段。 */
    }
    return probe_stage[candidate == 0x3D]; /* 返回与该候选地址绑定的阶段。 */
}
void Oled_SetLine(int row, const char *text) /* 完整覆盖一行，避免短文字后遗留旧字符。 */
{
    int column = 0; /* 从行首开始复制。 */
    if (row < 0 || row >= OLED_TEXT_ROWS || text == NULL) /* 拒绝越界行号与空指针。 */
    {
        return; /* 不访问屏幕缓冲以外的内存。 */
    }
    memset(lines[row], ' ', OLED_TEXT_COLUMNS); /* 先把整行填为空格。 */
    while (text[column] != '\0' && column < OLED_TEXT_COLUMNS) /* 最多复制屏幕能容纳的21个字符。 */
    {
        lines[row][column] = text[column]; /* 保存当前字符。 */
        ++column; /* 移动到下一字符。 */
    }
    lines[row][OLED_TEXT_COLUMNS] = '\0'; /* 保留合法的字符串终止符。 */
}
void Oled_SetProgressCallback(void (*callback)(int completed_pages)) /* 允许主程序报告实际发送进度。 */
{
    progress_callback = callback; /* 只保存函数地址，注册时不执行任何通信。 */
}
int Oled_Flush(void) /* 逐页定位并刷新全部像素。 */
{
    int row, column, pixel, offset; /* 分别遍历页、字符、字形列和本页分包偏移。 */
    uint8_t packet[OLED_WIDTH + 1]; /* 第一字节为数据控制字，随后是128个像素列。 */
    uint8_t chunk[OLED_DATA_CHUNK_BYTES + 1]; /* 每笔独立交易带一个控制字和至多16个像素字节。 */
    uint8_t command[4] = {OLED_CONTROL_COMMAND, OLED_PAGE_BASE, OLED_COLUMN_LOW, OLED_COLUMN_HIGH}; /* 准备页面定位命令。 */
    if (!online) /* 离线时不对每页重复超时。 */
    {
        return 0; /* 让上层负责低频重连。 */
    }
    for (row = 0; row < OLED_TEXT_ROWS; ++row) /* 按顺序处理八页。 */
    {
        command[1] = (uint8_t)(OLED_PAGE_BASE + row); /* 选择当前页。 */
        if (!SendBytes(command, sizeof(command))) /* 先设置页地址和列零点。 */
        {
            return 0; /* 定位失败立即结束刷新。 */
        }
        memset(packet, 0, sizeof(packet)); /* 清空全部像素，包括每行末尾的两列。 */
        packet[0] = OLED_CONTROL_DATA; /* 后续128字节为显示数据。 */
        for (column = 0; column < OLED_TEXT_COLUMNS; ++column) /* 转换本页的21个字符。 */
        {
            const char *found = strchr(glyph_names, lines[row][column]); /* 查找字符对应的字形索引。 */
            int glyph = found != NULL && *found != '\0' ? (int)(found - glyph_names) : (int)(strchr(glyph_names, '?') - glyph_names); /* 未支持的字符显示问号。 */
            for (pixel = 0; pixel < OLED_GLYPH_WIDTH; ++pixel) /* 写入字形的五列像素。 */
            {
                packet[1 + column * OLED_CHARACTER_WIDTH + pixel] = glyphs[glyph][pixel]; /* 每字符之后保留一列黑色间隔。 */
            }
        }

#if OLED_DIAGNOSTIC_MODE == 2
        /* 测试GDDRAM写入路径，绕开ASCII字库和文字缓冲的影响。 */
        memset(&packet[1], 0xFF, OLED_WIDTH);
#endif
        for (offset = 0; offset < OLED_WIDTH; offset += OLED_DATA_CHUNK_BYTES) /* 每页拆成八笔交易，列指针由SSD1306逐字节递增。 */
        {
            int remaining = OLED_WIDTH - offset; /* 计算当前页还未发送的像素字节数。 */
            int count = remaining < OLED_DATA_CHUNK_BYTES ? remaining : OLED_DATA_CHUNK_BYTES; /* 最后一包只发送剩余数据，避免越界。 */
            chunk[0] = OLED_CONTROL_DATA; /* 每个START之后都必须重新发送0x40数据控制字。 */
            memcpy(&chunk[1], &packet[1 + offset], (size_t)count); /* 复制本包对应的连续像素列，不覆盖前面已发送的列。 */
            if (!SendBytes(chunk, (uint16_t)(count + 1))) /* 每包独立START、地址、控制字、数据、ACK和STOP。 */
            {
                return 0; /* 任一分包失败就离线退出，禁止遗漏像素后报告成功。 */
            }
        }
        if (progress_callback != NULL) /* 页内八包全部成功后才报告进度。 */
        {
            progress_callback(row + 1); /* 当前交易已经STOP；回调只能报告进度，不可再次调用OLED接口。 */
        }
    }
    return 1; /* 八页均传输成功。 */
}
int Oled_Init(void) /* 自动识别模块常见七位地址并执行完整初始化。 */
{
    const uint8_t candidates[] = {0x3C, 0x3D}; /* SSD1306的地址选择位决定这两个七位地址。 */
    uint8_t direct_probe[] = {OLED_CONTROL_COMMAND, OLED_DISPLAY_OFF}; /* 当仿真模型不响应空地址探测时，用合法的关屏命令再次试探。 */
    uint8_t setup[] = {OLED_CONTROL_COMMAND, OLED_DISPLAY_OFF, OLED_CLOCK, OLED_CLOCK_DEFAULT, OLED_MULTIPLEX, OLED_LAST_ROW, OLED_OFFSET, OLED_ZERO_OFFSET, OLED_START_LINE, OLED_CHARGE_PUMP, OLED_PUMP_ENABLE, OLED_ADDRESS_MODE, OLED_PAGE_MODE, OLED_SEGMENT_REMAP, OLED_COM_REVERSE, OLED_COM_PINS, OLED_COM_64_ROWS, OLED_CONTRAST, OLED_CONTRAST_NORMAL, OLED_PRECHARGE, OLED_PRECHARGE_INTERNAL, OLED_VCOM, OLED_VCOM_NORMAL, OLED_USE_RAM, OLED_NORMAL_PIXELS, OLED_SCROLL_OFF}; /* 用已命名命令配置128乘64屏幕。 */
    uint8_t on[] = {OLED_CONTROL_COMMAND, OLED_DISPLAY_ON}; /* 最后开启已清空的画面。 */
    int index; /* 遍历两个候选地址和八行文字。 */
    online = 0; /* 每次重新探测前清除旧在线状态。 */
    address_7bit = 0; /* 清除上次连接的地址。 */
    for (index = 0; index < (int)sizeof(candidates); ++index) /* 清除上一轮两个地址的结果，包括本轮可能跳过的地址。 */
    {
        probe_error[index] = "NOT_TRIED"; /* 明确区分未尝试和确实无应答。 */
        probe_stage[index] = "IDLE"; /* 未尝试的地址没有失败阶段。 */
    }
    for (index = 0; index < (int)sizeof(candidates); ++index) /* 只探测SSD1306的两个地址，不扫描整条总线。 */
    {
#if OLED_USE_SOFTWARE_I2C /* GPIO方案直接用有效SSD1306命令探测，检查地址及数据ACK。 */
        int acknowledged = OledBus_Write(candidates[index], direct_probe, sizeof(direct_probe)); /* 七位地址由总线层统一转换。 */
        probe_error[index] = OledBus_Error(); /* 在下一次交易覆盖总线状态前保存该地址的错误。 */
        probe_stage[index] = OledBus_Stage(); /* 同时保存ADDRESS、CONTROL或PAYLOAD等阶段。 */
#else /* 硬件对照方案保留原来的两种探测过程。 */
        int acknowledged = HAL_I2C_IsDeviceReady(&hi2c1, (uint16_t)(candidates[index] << 1), 1, OLED_PROBE_TIMEOUT_MS) == HAL_OK; /* 先尝试标准的限时地址探测。 */
        if (!acknowledged) /* 某些仿真模型可能不响应只含地址的探测过程。 */
        {
            acknowledged = HAL_I2C_Master_Transmit(&hi2c1, (uint16_t)(candidates[index] << 1), direct_probe, sizeof(direct_probe), OLED_TIMEOUT_MS) == HAL_OK; /* 再发送有效SSD1306命令，成功才承认屏幕在线。 */
        }
#endif /* 两种驱动都必须确认应答才能把屏幕标为在线。 */
        if (acknowledged) /* 两种探测方式只要有一次真正收到应答即可初始化。 */
        {
            address_7bit = candidates[index]; /* 保存真正应答的七位地址。 */
            online = 1; /* 允许接下来的初始化传输。 */
            break; /* 找到一个屏幕后结束探测。 */
        }
    }
    if (!online || !SendBytes(setup, sizeof(setup))) /* 未找到模块或配置失败时立即返回。 */
    {
        return 0; /* 由上层通过串口提示离线。 */
    }
    for (index = 0; index < OLED_TEXT_ROWS; ++index) /* 清空所有文本行。 */
    {
        Oled_SetLine(index, ""); /* 生成全空格的一行。 */
    }
    if (!Oled_Flush() || !SendBytes(on, sizeof(on))) /* 先清屏，再发送0xAF开启显示。 */
    {
        return 0; /* 任一步失败时保留已有错误报告。 */
    }
#if OLED_DIAGNOSTIC_MODE == 1
    {
        uint8_t force_on[] = {OLED_CONTROL_COMMAND, 0xA5}; /* A5强制全亮，完全绕过显示RAM和字模。 */
        return SendBytes(force_on, sizeof(force_on)); /* 只有真实收到ACK才算诊断命令发出成功。 */
    }
#else
    return 1; /* 模式0正常刷新文字；模式2改用GDDRAM全亮诊断。 */
#endif
}
